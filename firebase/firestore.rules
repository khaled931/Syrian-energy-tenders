rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /tenders/{tenderId} {
      // Public and Free-member reads are served only through the server-side
      // application API, which applies membership limits and strips protected
      // source/provenance fields before returning any record to a browser.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
  }
}
