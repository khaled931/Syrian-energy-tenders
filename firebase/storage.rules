rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /tenders/{tenderId}/{allPaths=**} {
      // Tender source documents are protected assets. Guest and Free accounts
      // never receive direct storage access; future paid access must be served
      // through an authenticated server endpoint with explicit authorization.
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
